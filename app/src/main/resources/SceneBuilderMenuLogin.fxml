<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="350.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label text="Quel est ton nom d'utilisateur ?" styleClass="title-label"></Label>

      <TextField fx:id="searchBar" maxWidth="500.0" prefHeight="35.0" promptText="Entre ton nom d'utilisateur ici..." VBox.vgrow="NEVER" />

      <ListView fx:id="listView" maxWidth="500.0" prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />

      <Button fx:id="btnValider" text="valider" styleClass="button" mnemonicParsing="false" />
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</VBox>